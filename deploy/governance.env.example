# Governance-substrate deployment env (R1 + R2). Copy to deploy/.env and fill in.
# Values are PER-DEPLOYMENT; never commit a filled .env. See deploy/GOVERNANCE_DEPLOYMENT.md.
# The gate is run via the R1 wiring shim:
#   uvicorn deploy.governance.approver_trust_bootstrap:app

# --- Gate issuer identity (the gate's OWN signing key) -----------------------
ELYON_SIGNING_KEY_HEX=            # gate Ed25519 private key (hex); gate host only
ELYON_SIGNING_KEY_ID=gate-issuer # the gate's issuer key id (also the SoD gate_key_id)
ELYON_DECISION_MAX_AGE_SECONDS=300

# --- R1: approver provenance + role (signed key-record chain) ----------------
# The gate trusts approver keys ONLY via this signed record, by ROLE == "approver".
ELYON_APPROVER_KEY_RECORD_PATH=/app/deploy/governance/approver_key_record.json
ELYON_PINNED_ROOT_KEY_ID=root-1          # the root_key_id pinned out-of-band
ELYON_PINNED_ROOT_PUBKEY_B64=            # base64(raw Ed25519) of the pinned root pubkey
ELYON_CLOCK_SKEW_SECONDS=0               # optional cross-host skew for key windows

# --- R1 approver CLI process (SEPARATE host/container; CUSTODY) --------------
# The approver PRIVATE key lives ONLY here, never on the gate. Used by
# IMPLEMENTATION/approver_cli.py to mint a signed grant on a human's action.
ELYON_APPROVER_KEY_HEX=          # approver Ed25519 private key (hex) - approver host ONLY
ELYON_APPROVER_KEY_ID=approver-1 # must match the "approver"-role key_id in the record

# --- R2: shared store so single-use + the 202 pending-set hold across replicas
# A multi-instance gate MUST set both URLs; declaring MULTI_INSTANCE without them
# fails the gate closed at startup (the R-02 guard).
ELYON_REPLAY_MULTI_INSTANCE=1
ELYON_PENDING_REDIS_URL=redis://redis:6379/0
ELYON_REPLAY_REDIS_URL=redis://redis:6379/0

# --- Audit logs (optional but recommended; reconcile_approvals consumes them) -
ELYON_ISSUANCE_LOG_PATH=/app/EVIDENCE/runtime/issuance.log
ELYON_APPROVAL_LOG_PATH=/app/EVIDENCE/runtime/approval.log

# --- Feature 2 (non-bypassable): see deploy/NONBYPASS_TOPOLOGY.md -------------
# Layer 2 (mTLS gate->target), enabled via the TLS overlay + these on the hop:
ELYON_TLS_CA_BUNDLE=/certs/ca.crt
ELYON_TLS_CLIENT_CERT=/certs/gate-client.crt   # (+ key) the gate presents to the target
